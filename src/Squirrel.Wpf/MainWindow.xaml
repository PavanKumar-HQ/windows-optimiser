<Window x:Class="Squirrel.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Squirrel.Wpf.ViewModels"
        Title="Squirrel — Personal Laptop Diagnostic &amp; Optimizer (LapMac)"
        Height="740" Width="1120"
        MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDark}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR NAVIGATION -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,1,0">
            <Grid Margin="16,20,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="🐿️ SQUIRREL" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="Personal Laptop Optimizer" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                    <TextBlock Text="AMD PRO A4 · 8 GB RAM · LapMac" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Safety Status Pill -->
                <Border Grid.Row="1" Background="#064E3B" CornerRadius="6" Padding="8,6" Margin="0,0,0,20">
                    <TextBlock Text="🛡️ Safe Mode: Office &amp; OS Protected" FontSize="10" FontWeight="SemiBold" Foreground="#34D399" TextAlignment="Center" />
                </Border>

                <!-- Navigation Buttons -->
                <StackPanel Grid.Row="2">
                    <Button Content="📊  Live Dashboard" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,8"
                            Command="{Binding SelectTabCommand}" CommandParameter="Dashboard" />
                    <Button Content="🔍  Bottleneck Scan" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,8"
                            Command="{Binding SelectTabCommand}" CommandParameter="Bottlenecks" />
                    <Button Content="🚀  Startup Programs" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,8"
                            Command="{Binding SelectTabCommand}" CommandParameter="Startup" />
                    <Button Content="🧹  Storage Cleaner" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,8"
                            Command="{Binding SelectTabCommand}" CommandParameter="Storage" />
                    <Button Content="💡  Recommendations" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,8"
                            Command="{Binding SelectTabCommand}" CommandParameter="Recommendations" />
                    <Button Content="📜  Audit History" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,8"
                            Command="{Binding SelectTabCommand}" CommandParameter="History" />
                </StackPanel>

                <!-- Footprint Self-Monitor -->
                <Border Grid.Row="3" Background="{StaticResource SurfaceCard}" CornerRadius="6" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Squirrel Self-Footprint:" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding CurrentMetrics.SquirrelWorkingSetMb, StringFormat='RAM: {0:F1} MB'}" FontSize="11" Foreground="{StaticResource SuccessGreen}" />
                        <TextBlock Text="{Binding CurrentMetrics.SquirrelCpuPercent, StringFormat='CPU: {0:F1}%'}" FontSize="11" Foreground="{StaticResource AccentPrimary}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1" Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding SelectedTab}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />

                    <!-- Quick Metrics Strip -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource SurfaceCard}" CornerRadius="4" Padding="10,5" Margin="0,0,8,0">
                            <TextBlock Text="{Binding CurrentMetrics.TotalCpuPercent, StringFormat='CPU: {0:F1}%'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentPrimary}" />
                        </Border>
                        <Border Background="{StaticResource SurfaceCard}" CornerRadius="4" Padding="10,5" Margin="0,0,8,0">
                            <TextBlock Text="{Binding CurrentMetrics.MemoryUsagePercent, StringFormat='RAM: {0:F0}%'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessGreen}" />
                        </Border>
                        <Border Background="{StaticResource SurfaceCard}" CornerRadius="4" Padding="10,5">
                            <TextBlock Text="{Binding CurrentMetrics.SystemDriveFreeGb, StringFormat='SSD Free: {0:F1} GB'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Area with Tab Switching -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
                <Grid>
                    <!-- TAB 1: DASHBOARD -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTab}" Value="Dashboard">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- Hardware Metric Cards -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="PROCESSOR (CPU)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
                                    <TextBlock Text="{Binding CurrentMetrics.TotalCpuPercent, StringFormat='{}{0:F1}%'}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentPrimary}" Margin="0,4,0,4" />
                                    <ProgressBar Value="{Binding CurrentMetrics.TotalCpuPercent}" Maximum="100" Height="6" Foreground="{StaticResource AccentPrimary}" Background="{StaticResource SurfaceDark}" BorderThickness="0" Margin="0,0,0,6" />
                                    <TextBlock Text="AMD PRO A4-4350B (2 Cores)" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="SYSTEM MEMORY (RAM)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
                                    <TextBlock Text="{Binding CurrentMetrics.MemoryUsagePercent, StringFormat='{}{0:F0}%'}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" Margin="0,4,0,4" />
                                    <ProgressBar Value="{Binding CurrentMetrics.MemoryUsagePercent}" Maximum="100" Height="6" Foreground="{StaticResource SuccessGreen}" Background="{StaticResource SurfaceDark}" BorderThickness="0" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding CurrentMetrics.UsedMemoryMb, StringFormat='Used: {0:F0} MB of 8 GB'}" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="SSD STORAGE (C:)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
                                    <TextBlock Text="{Binding CurrentMetrics.SystemDriveFreeGb, StringFormat='{}{0:F1} GB'}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,4" />
                                    <ProgressBar Value="{Binding CurrentMetrics.SystemDriveUsedPercent}" Maximum="100" Height="6" Foreground="{StaticResource TextSecondary}" Background="{StaticResource SurfaceDark}" BorderThickness="0" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding CurrentMetrics.SystemDriveTotalGb, StringFormat='Free space of {0:F0} GB SSD'}" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Overview Card -->
                        <Border Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="Quick Optimization Workflows" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock Text="Diagnose sustained CPU hogs first before assuming storage cleaning will fix laptop performance. Every action requires your approval and is recorded in the audit history." FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,16" />
                                <WrapPanel>
                                    <Button Content="🔍 Run 5-Sample Bottleneck Scan" Style="{StaticResource PrimaryButton}" Margin="0,0,10,8" Command="{Binding RunBottleneckScanCommand}" />
                                    <Button Content="🚀 Inspect Startup Programs" Style="{StaticResource SecondaryButton}" Margin="0,0,10,8" Command="{Binding SelectTabCommand}" CommandParameter="Startup" />
                                    <Button Content="🧹 Scan Safe Storage Caches" Style="{StaticResource SecondaryButton}" Margin="0,0,10,8" Command="{Binding SelectTabCommand}" CommandParameter="Storage" />
                                    <Button Content="💡 View Recommendations" Style="{StaticResource SecondaryButton}" Margin="0,0,10,8" Command="{Binding SelectTabCommand}" CommandParameter="Recommendations" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Recent Diagnostic Findings -->
                        <Border Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Diagnostic Status &amp; Recent Baseline" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding DiagnosticProgressMessage}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12" />
                                <ItemsControl ItemsSource="{Binding BottleneckReport.Findings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat='{}• {0}'}" FontSize="12" Foreground="{StaticResource TextPrimary}" Margin="0,3" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- TAB 2: BOTTLENECK SCAN -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTab}" Value="Bottlenecks">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Border Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Repeated-Sample Bottleneck Detection" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Text="Takes 5 consecutive samples over 7.5 seconds. Distinguishes sustained background CPU hogs from normal momentary spikes." FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding DiagnosticProgressMessage}" FontSize="12" Foreground="{StaticResource AccentPrimary}" FontWeight="Medium" Margin="0,10,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Start 5-Sample Scan" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Command="{Binding RunBottleneckScanCommand}" />
                            </Grid>
                        </Border>

                        <!-- Findings -->
                        <Border Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Diagnostic Findings" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding BottleneckReport.Findings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat='{}• {0}'}" FontSize="12" Foreground="{StaticResource TextPrimary}" Margin="0,3" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Sustained Offenders List -->
                        <Border Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Sustained High CPU Offenders" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />
                                <ItemsControl ItemsSource="{Binding BottleneckReport.SustainedCpuOffenders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding ProcessName}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                                        <TextBlock Text="{Binding ProtectionReason}" FontSize="11" Foreground="{StaticResource WarningAmber}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding AverageCpuPercent, StringFormat='Avg CPU: {0:F1}%'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentPrimary}" />
                                                        <TextBlock Text="{Binding WorkingSetMb, StringFormat='RAM: {0:F0} MB'}" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- TAB 3: STARTUP APPS -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTab}" Value="Startup">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Border Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Startup Program Manager" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Text="Disabling startup items stops them from running automatically on boot, freeing dual-core CPU and RAM. Reversible with one click. Microsoft Office and essential drivers are strictly protected." FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Refresh List" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Command="{Binding RefreshStartupCommand}" />
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding StartupItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,8,0" />
                                                    <Border Background="{StaticResource SurfaceDark}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource TextSecondary}" />
                                                    </Border>
                                                    <Border Background="{StaticResource SurfaceDark}" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding Impact, StringFormat='Impact: {0}'}" FontSize="10" Foreground="{StaticResource WarningAmber}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding CommandLine}" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding SafetyExplanation}" FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                                            </StackPanel>

                                            <!-- Action Button -->
                                            <Button Grid.Column="1" Content="{Binding ActionText}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Margin="16,0,0,0"
                                                    Command="{Binding DataContext.ToggleStartupItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- TAB 4: STORAGE CLEANER -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTab}" Value="Storage">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Border Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Review-First Safe Storage Cleaner" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="Personal folders (Documents, Desktop, Downloads, OneDrive, Office) are strictly protected. Squirrel targets only temporary files and completed update packages. You must explicitly review and confirm cleanup." FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,16" />
                                <WrapPanel>
                                    <Button Content="🔍 Re-scan Targets" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Command="{Binding ScanStorageCommand}" />
                                    <Button Content="🧪 Dry-Run Simulation (Deletes Nothing)" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Command="{Binding DryRunStorageCommand}" />
                                    <Button Content="🧹 Clean Selected Targets" Style="{StaticResource DangerButton}" Command="{Binding CleanSelectedStorageCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding CleanupTargets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox IsChecked="{Binding IsSelectedForCleanup}" VerticalAlignment="Center" Margin="0,0,16,0" />

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,2" />
                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding SafetyNotes}" FontSize="11" Foreground="{StaticResource SuccessGreen}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SizeMb, StringFormat='{}{0:F1} MB'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding FileCount, StringFormat='{}{0} items'}" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- TAB 5: RECOMMENDATIONS -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTab}" Value="Recommendations">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Border Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Evidence-Based Performance Proposals" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Text="Every recommendation is based on measured hardware data and tailored for your 2-core AMD A4 laptop. No blanket debloating scripts or registry hacks." FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Refresh Proposals" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Command="{Binding RefreshRecommendationsCommand}" />
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Recommendations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,8,0" />
                                                    <Border Background="{StaticResource SurfaceDark}" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource AccentPrimary}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Explanation}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Evidence, StringFormat='Evidence: {0}'}" FontSize="11" Foreground="{StaticResource WarningAmber}" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding ExpectedBenefit, StringFormat='Expected Benefit: {0}'}" FontSize="11" Foreground="{StaticResource SuccessGreen}" FontWeight="Medium" TextWrapping="Wrap" />
                                            </StackPanel>

                                            <!-- Action Button -->
                                            <Button Grid.Column="1" Content="Execute Action" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Margin="16,0,0,0"
                                                    Visibility="{Binding IsActionAvailable, Converter={StaticResource BoolToVisConverter}}"
                                                    Command="{Binding DataContext.ExecuteRecommendationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- TAB 6: AUDIT HISTORY -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTab}" Value="History">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Border Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Local Audit History Ledger" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Text="Persistent local log of every change made to your computer. Reversible actions (like disabled startup items) can be restored with a single click." FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Refresh Ledger" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Command="{Binding RefreshAuditHistoryCommand}" />
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding AuditEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding ActionType}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,8,0" />
                                                    <Border Background="{StaticResource SurfaceDark}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding Status}" FontSize="10" Foreground="{StaticResource SuccessGreen}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding TimestampUtc, StringFormat='{}[{0:yyyy-MM-dd HH:mm UTC}]'}" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding TargetName, StringFormat='Target: {0}'}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,2" />
                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                                            </StackPanel>

                                            <Button Grid.Column="1" Content="Rollback" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Margin="16,0,0,0"
                                                    Command="{Binding DataContext.RollbackAuditEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Bottom Status Bar -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,0" Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Personal Build · Strictly Local · LapMac" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
